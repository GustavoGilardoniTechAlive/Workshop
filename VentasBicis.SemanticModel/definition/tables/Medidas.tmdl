table Medidas
	lineageTag: 024de8f5-daa6-4884-9c10-7dcc401d6739

	measure 'Precio Medio' = DIVIDE([Ventas Totales], [Unidades])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0b1a0be3-3d96-510d-bef3-e2d12cc93d7f

	measure Unidades = SUM(Ventas[Cantidad])
		formatString: #,0
		lineageTag: d17b7826-a197-59fb-b57a-c6fcf518e7f9

	measure 'Ventas Totales' = SUMX(Ventas, Ventas[Cantidad] * RELATED(Producto[PrecioUnitario]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 3c7d3768-f959-59e8-958b-886bde8249ce

	measure 'Cantidad Promedio' = AVERAGE(Ventas[Cantidad])
		lineageTag: 5466f398-88a1-49bf-9c36-3b3be7f6a80d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Medidas = m
		mode: import
