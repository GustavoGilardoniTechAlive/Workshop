{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "ventasPorMes",
  "position": {
    "x": 640,
    "y": 160,
    "z": 5,
    "height": 540,
    "width": 620,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Calendario"
                    }
                  },
                  "Property": "AñoMes"
                }
              },
              "queryRef": "Calendario.AñoMes",
              "nativeQueryRef": "AñoMes",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas"
                    }
                  },
                  "Property": "Ventas Totales"
                }
              },
              "queryRef": "Ventas.Ventas Totales",
              "nativeQueryRef": "Ventas Totales"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}